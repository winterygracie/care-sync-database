{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered system staff user profile and role assignment for Ampayon CareSync.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Authentication user ID."
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Full display name of the staff member."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 180,
          "description": "Staff email address."
        },
        "role": {
          "type": "string",
          "enum": ["Doctor", "Nurse", "BHW", "Administrative Clerk", "Data Controller", "Midwife"],
          "description": "Assigned clinical or administrative role."
        },
        "accountStatus": {
          "type": "string",
          "enum": ["active", "inactive"],
          "description": "Whether the staff account is permitted to access the system."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the account was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the account was last updated."
        },
        "lastLogin": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the user's latest login."
        }
      },
      "required": ["uid", "fullName", "email", "role", "accountStatus", "createdAt", "updatedAt", "lastLogin"]
    },
    "StaffProfile": {
      "title": "StaffProfile",
      "description": "Non-PII staff directory entry used to resolve staff names and roles across clinical workflows without exposing email addresses.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["Doctor", "Nurse", "BHW", "Administrative Clerk", "Data Controller", "Midwife"]
        },
        "accountStatus": {
          "type": "string",
          "enum": ["active", "inactive"]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "fullName", "role", "accountStatus", "updatedAt"]
    },
    "Patient": {
      "title": "Patient",
      "description": "Registered patient demographic profile with duplicate-detection metadata.",
      "type": "object",
      "properties": {
        "patientId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique human-readable patient identifier."
        },
        "firstName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "middleName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80
        },
        "lastName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "normalizedKey": {
          "type": "string",
          "minLength": 3,
          "maxLength": 180,
          "description": "Lowercase trimmed composite key: firstName|lastName|dateOfBirth."
        },
        "dateOfBirth": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "sex": {
          "type": "string",
          "enum": ["Male", "Female", "Other"]
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        },
        "contactNumber": {
          "type": "string",
          "minLength": 0,
          "maxLength": 30
        },
        "emergencyContact": {
          "type": "string",
          "minLength": 0,
          "maxLength": 150
        },
        "registrationDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "registeredBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "duplicateStatus": {
          "type": "string",
          "enum": ["clear", "flagged", "confirmed_unique", "confirmed_duplicate"]
        },
        "possibleDuplicateOf": {
          "type": "array",
          "description": "Up to 10 matched patientIds flagged during registration."
        },
        "duplicateReviewedBy": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        },
        "duplicateReviewedAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "patientId",
        "firstName",
        "middleName",
        "lastName",
        "normalizedKey",
        "dateOfBirth",
        "sex",
        "address",
        "contactNumber",
        "emergencyContact",
        "registrationDate",
        "registeredBy",
        "duplicateStatus",
        "possibleDuplicateOf",
        "duplicateReviewedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "MedicalRecord": {
      "title": "MedicalRecord",
      "description": "Longitudinal patient clinical summary including conditions, allergies, medications, and maternal health notes.",
      "type": "object",
      "properties": {
        "recordId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "patientId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "medicalConditions": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "allergies": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        },
        "medications": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "medicalHistory": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4000
        },
        "maternalHealthNotes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "notes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "recordId",
        "patientId",
        "medicalConditions",
        "allergies",
        "medications",
        "medicalHistory",
        "maternalHealthNotes",
        "notes",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "Visit": {
      "title": "Visit",
      "description": "Individual clinical consultation and treatment record appended to a patient profile.",
      "type": "object",
      "properties": {
        "visitId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"

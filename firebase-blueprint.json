        "actionType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "affectedCollection": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "affectedRecordId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "logId",
        "userId",
        "userName",
        "userRole",
        "actionType",
        "affectedCollection",
        "affectedRecordId",
        "description",
        "timestamp"
      ]

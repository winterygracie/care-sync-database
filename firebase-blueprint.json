          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "visitDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "symptoms": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "diagnosis": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "prescribedTreatment": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "notes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "recordedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "visitId",
        "patientId",
        "visitDate",
        "symptoms",
        "diagnosis",
        "prescribedTreatment",
        "notes",
        "recordedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "VitalSign": {
      "title": "VitalSign",
      "description": "Patient physiological measurements and clinical observations.",
      "type": "object",
      "properties": {
        "vitalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "patientId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "visitId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        },
        "bloodPressure": {
          "type": "string",
          "minLength": 0,
          "maxLength": 30
        },
        "temperature": {
          "type": "number",

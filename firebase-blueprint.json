        "otherMeasurements": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "notes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        },
        "recordedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "recordedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "vitalId",
        "patientId",
        "visitId",
        "bloodPressure",
        "temperature",
        "heartRate",
        "respiratoryRate",
        "weight",
        "height",
        "otherMeasurements",
        "notes",
        "recordedBy",
        "recordedAt"
      ]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Scheduled patient consultation or follow-up appointment.",
      "type": "object",
      "properties": {
        "appointmentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "patientId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "patientName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "appointmentDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "appointmentTime": {
          "type": "string",
          "minLength": 4,
          "maxLength": 10
        },
        "appointmentType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "enum": ["scheduled", "completed", "cancelled", "missed"]
        },
        "notes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "appointmentId",
        "patientId",
        "patientName",
        "appointmentDate",
        "appointmentTime",
        "appointmentType",
        "purpose",
        "status",
        "notes",
        "createdBy",
        "updatedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "InventoryItem": {
      "title": "InventoryItem",

      "type": "object",
      "properties": {
        "itemId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "itemName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "totalQuantity": {
          "type": "number"
        },
        "minimumStockLevel": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "itemId",
        "itemName",
        "category",
        "description",
        "unit",
        "totalQuantity",
        "minimumStockLevel",
        "createdAt",
        "updatedAt"
      ]
    },
    "InventoryBatch": {
      "title": "InventoryBatch",
      "description": "Batch-level supply lot supporting First Expired, First Out (FEFO) dispensing.",
      "type": "object",
      "properties": {
        "batchId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "itemId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "batchNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "quantityReceived": {
          "type": "number"
        },
        "remainingQuantity": {
          "type": "number"
        },
        "expirationDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "dateReceived": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "receivedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "batchId",
        "itemId",
        "batchNumber",
        "quantityReceived",
        "remainingQuantity",
        "expirationDate",
        "dateReceived",
        "receivedBy",
        "createdAt"
      ]
    },
    "InventoryTransaction": {
      "title": "InventoryTransaction",
      "description": "Immutable ledger entry for inventory receiving, FEFO dispensing, and stock adjustments.",
      "type": "object",
      "properties": {
        "transactionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "itemId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "batchId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "transactionType": {
          "type": "string",
          "enum": ["received", "dispensed", "stock_adjustment"]
        },
        "quantity": {
          "type": "number"
        },
        "previousQuantity": {
          "type": "number"
        },
        "newQuantity": {
          "type": "number"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "reference": {
          "type": "string",
          "minLength": 0,
          "maxLength": 150
        },
        "performedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "transactionId",
        "itemId",
        "batchId",
        "transactionType",
        "quantity",
        "previousQuantity",
        "newQuantity",
        "reason",
        "reference",
        "performedBy",
        "timestamp"
      ]
    },
    "Notification": {
      "title": "Notification",
      "description": "Targeted operational alert for next-day appointments, low-stock thresholds, and duplicate patient reviews.",
      "type": "object",
      "properties": {
        "notificationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "notificationType": {
          "type": "string",
          "enum": ["appointment_followup", "low_stock", "duplicate_review", "system"]
        },
        "recipientRoles": {
          "type": "array",
          "description": "Target staff roles (1 to 6 items)."
        },
        "recipientUserIds": {
          "type": "array",
          "description": "Target staff user IDs (up to 50 items)."
        },
        "relatedRecordId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        },
        "isRead": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "notificationId",
        "title",
        "message",
        "notificationType",
        "recipientRoles",
        "recipientUserIds",
        "relatedRecordId",
        "isRead",
        "createdAt"
      ]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable activity audit record for compliance and security traceability.",
      "type": "object",
      "properties": {
        "logId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,

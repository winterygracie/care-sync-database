  },
  "firestore": {
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Private user account records including email and assigned RBAC role."
    },
    "/staffProfiles/{uid}": {
      "schema": { "$ref": "#/entities/StaffProfile" },
      "description": "Non-PII staff directory for displaying clinician names and targeting notifications."
    },
    "/patients/{patientId}": {
      "schema": { "$ref": "#/entities/Patient" },
      "description": "Master patient demographic profiles."
    },
    "/medicalRecords/{recordId}": {
      "schema": { "$ref": "#/entities/MedicalRecord" },
      "description": "Clinical medical history, allergies, medications, and maternal notes."
    },
    "/visits/{visitId}": {
      "schema": { "$ref": "#/entities/Visit" },
      "description": "Patient clinical consultations and prescribed treatments."
    },
    "/vitalSigns/{vitalId}": {
      "schema": { "$ref": "#/entities/VitalSign" },
      "description": "Patient vital sign measurements linked to patients and visits."
    },
    "/appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "Patient appointment schedule records."
    },
    "/inventory/{itemId}": {
      "schema": { "$ref": "#/entities/InventoryItem" },
      "description": "Medical supply catalog and aggregate quantities."
    },
    "/inventoryBatches/{batchId}": {
      "schema": { "$ref": "#/entities/InventoryBatch" },
      "description": "Batch-tracked supply inventory for FEFO enforcement."
    },
    "/inventoryTransactions/{transactionId}": {
      "schema": { "$ref": "#/entities/InventoryTransaction" },
      "description": "Immutable inventory ledger entries."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Operational notifications targeted to authorized staff roles and users."
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable system audit log entries."
    }
  }
}
